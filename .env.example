# ==============================================================================
# Unified Hybrid ALinkNER: Master Environment Configuration (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Active LLM Provider Selection & General Parameters
# ------------------------------------------------------------------------------
# Available options for LLM_BACKEND / LLM_PROVIDER:
#   - api / 9router  : 9Router / OmniRoute Local Gateway (http://localhost:20128/v1 or http://localhost:1234/v1)
#   - openai         : Official OpenAI API (https://api.openai.com/v1)
#   - openrouter     : OpenRouter Cloud API (https://openrouter.ai/api/v1)
#   - ollama         : Local Ollama daemon (http://localhost:11434/v1)
#   - lmstudio       : Local LMStudio daemon (http://localhost:1234/v1)
#   - unsloth        : Local Unsloth Studio Backend (http://127.0.0.1:8888/v1)
#   - nvidia         : NVIDIA Cloud API NIM (https://integrate.api.nvidia.com/v1)
#   - dummy          : Mock offline dummy provider (0 external network calls, instant test execution)
LLM_BACKEND=api
LLM_PROVIDER=9router

# Model name to request from the active provider
# Examples:
#   - 9router/OmniRoute : gemini-cli, ag/gemini-3.7-flash-high, deepseek-web/deepseek-chat
#   - OpenAI endpoints  : gpt-4o, gpt-4o-mini
#   - OpenRouter        : deepseek/deepseek-v4-flash-0731, deepseek/deepseek-r1
LLM_MODEL=gemini-cli

# Sampling temperature (0.0 for deterministic greedy evaluation)
LLM_TEMPERATURE=0.0

# Maximum generated tokens for LLM classification response
LLM_MAX_TOKENS=4096

# Prompt version selection: 'v1' (ablation baseline), 'v2' (enriched), 'v3' (optimized hybrid)
PROMPT_VERSION=v1


# ------------------------------------------------------------------------------
# 2. Local Gateway & OpenAI-Compatible Endpoints (9Router, OmniRoute, LMStudio)
# ------------------------------------------------------------------------------
API_Base_URL=http://localhost:20128/v1
OPENAI_BASE_URL=http://localhost:20128/v1
API_KEY=your_local_gateway_api_key_here
LLM_API_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=your_llm_api_key_here
LMSTUDIO_BASE_URL=http://localhost:1234/v1
NINEROUTER_OPENAI_API_KEY=your_ninerouter_api_key_here


# ------------------------------------------------------------------------------
# 3. Cloud Provider Configurations (OpenAI, OpenRouter, NVIDIA)
# ------------------------------------------------------------------------------
# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1  # Set to https://api.openai.com/v1 for cloud OpenAI, or leave as local gateway URL above

# OpenRouter Cloud
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_PROVIDERS=DeepInfra,Decart

# Local Ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL_NAME=qwen3.6-35b
OLLAMA_API_KEY=ollama

# Local Unsloth Studio
UNSLOTH_STUDIO_BASE_URL=http://127.0.0.1:8888/v1
UNSLOTH_STUDIO_API_KEY=your_unsloth_api_key_here
UNSLOTH_MODEL_NAME=unsloth/Qwen3.6-35B-A3B-MTP-GGUF

# NVIDIA Cloud NIM
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=your_nvidia_api_key_here


# ------------------------------------------------------------------------------
# 4. Unreliability Risk Gate & Escalation Thresholds
# ------------------------------------------------------------------------------
# Formula: Unreliability = (w_novelty * Novelty_Score) + (w_uncertainty * SpanNER_Uncertainty)
# When a candidate span's Unreliability >= Threshold, it is escalated to the Generative LLM.
UNRELIABILITY_THRESHOLD=0.40
UNCERTAINTY_THRESHOLD=0.40
NOVELTY_THRESHOLD=0.35

# Component Weights (sum to 1.0)
WEIGHT_NOVELTY=0.5
WEIGHT_UNCERTAINTY=0.5
W_NOVELTY=0.5
W_UNCERTAINTY=0.5

# Active Uncertainty & Novelty Estimation Algorithms
# Uncertainty options : 'mcd' (Monte Carlo Dropout), 'pe' (Predictive Entropy), 'margin', 'lc' (Least Confidence)
# Novelty options     : 'lof' (Local Outlier Factor), 'knn', 'mahalanobis'
# Gating modes        : 'linear', 'max', 'nn', 'harmonic'
UNCERTAINTY_METHOD=mcd
NOVELTY_METRIC=lof
GATING_MODE=linear


# ------------------------------------------------------------------------------
# 5. LOF Vector Novelty Embedders (9Router Proxy / Local HuggingFace Fallback)
# ------------------------------------------------------------------------------
# Active Embedding Provider: '9router', 'local', or 'roberta'
EMBEDDING_PROVIDER=9router

# 9Router Combo Name
EMBEDDING_MODEL=un/Qwen3-Embedding-8B

# 9Router Endpoint URL & API Key
EMBEDDING_BASE_URL=http://localhost:20128/v1
EMBEDDING_API_KEY=your_embedding_api_key_here

# Device for fallback local inference ('mps', 'cuda', or 'cpu')
EMBEDDING_DEVICE=mps

# Fallback Local Model Paths
QWEN_EMBEDDING_PATH=models/Qwen3-Embedding-8B
BGE_EMBEDDING_MODEL=BAAI/bge-m3


# ------------------------------------------------------------------------------
# 6. Architecture & Dataset Selection (Universal Ablation Engine)
# ------------------------------------------------------------------------------
# Supported Architectures:
#   - dinasor_dingen     : SpanNER + Dinasor Hinting -> DinGenerator Dynamic Reflection Pipeline
#   - hybrid_linkner     : SpanNER + Single-Pass LLM Arbitration + LOF Novelty Scoring
#   - gating_nn          : SpanNER + Single Consolidated Prompt v1 with Inlined Spans & Neural Features (Notebook 02)
#   - agentic_guidelines : Pure LLM Self-Reflective Agentic Guidelines Pipeline (Generator, Reflector, Curator)
#   - spanner_only       : Baseline Local SpanNER Neural Model
#   - jebert             : JeBert Dual-Model Hybrid Architecture (SpanNER + Jev System One + Gating + Arbitrator)
ABLATION_ARCHITECTURE=dinasor_dingen

# Supported Datasets:
#   - balanced_val, balanced_test, balanced_train, 400_test, 400_val, 400_train, 200_test, 200_train, 600_all, relabeled_lsf200
ABLATION_DATASET=balanced_val


# ------------------------------------------------------------------------------
# 7. Pipeline Execution & Concurrency
# ------------------------------------------------------------------------------
BATCH_SIZE=5
MAX_WORKERS=4
RANDOM_SEED=42


# ------------------------------------------------------------------------------
# 8. Observability & Tracing (Weights & Biases / Langfuse)
# ------------------------------------------------------------------------------
WANDB_API_KEY=your_wandb_api_key_here
WEAVE_PROJECT=lsf-ner-tracing

LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_HOST=https://cloud.langfuse.com


# ------------------------------------------------------------------------------
# 9. Boundary Suppression & Candidate Extraction
# ------------------------------------------------------------------------------
APPLY_NMS=False  # Set to True to apply greedy Non-Maximum Suppression; False (default) preserves nested/overlapping entities


# ------------------------------------------------------------------------------
# 10. TypeSafe System One (Jev) & JeBert Dual-Model Architecture
# ------------------------------------------------------------------------------
TYPESAFE_API_KEY=your_typesafe_api_key_here
TYPESAFE_ENDPOINT=https://api.typesafe.ai/v1/systemone
TYPESAFE_MODEL=jev-latest
